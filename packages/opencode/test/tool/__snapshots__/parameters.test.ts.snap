exports[`tool parameters JSON Schema (wire shape) task 1`] = `
{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
    "background": {
      "description": "Run the agent in the background and return immediately",
      "type": "boolean",
    },
    "command": {
      "description": "The command that triggered this task",
      "type": "string",
    },
    "cwd": {
      "description": "Subagent working directory (relative to project root)",
      "type": "string",
    },
    "description": {
      "description": "A short (3-5 words) description of the task",
      "type": "string",
    },
    "fork_mode": {
      "description": "How much of the parent session trace the subagent receives. PromptOnly (default): no parent trace, only the prompt. LastNTurns: last 50 parent messages. FullHistory: entire parent trace.",
      "enum": [
        "PromptOnly",
        "LastNTurns",
        "FullHistory",
      ],
      "type": "string",
    },
    "isolation": {
      "description": "none (default): share project directory. worktree: git worktree under .opencode/worktrees/",
      "enum": [
        "none",
        "worktree",
      ],
      "type": "string",
    },
    "persona": {
      "description": "Named persona override for this spawn (identity instructions for the child)",
      "type": "string",
    },
    "prompt": {
      "description": "The task for the agent to perform",
      "type": "string",
    },
    "subagent_type": {
      "description": "The type of specialized agent to use for this task",
      "type": "string",
    },
    "task_id": {
      "description": "Resume a previous task (continues the same subagent session)",
      "type": "string",
    },
  },
  "required": [
    "description",
    "prompt",
    "subagent_type",
  ],
  "type": "object",
}
`;

