exports[`tool parameters JSON Schema (wire shape) bash 1`] = `
{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
    "background": {
      "description": "If true, return a jobID immediately and keep the command running. Use the job tool to get, wait, or kill it.",
      "type": "boolean",
    },
    "command": {
      "description": "Shell command string to execute",
      "type": "string",
    },
    "timeout": {
      "description": "Timeout in milliseconds. Defaults to 120000 and may not exceed 600000.",
      "exclusiveMinimum": 0,
      "maximum": 600000,
      "type": "integer",
    },
    "workdir": {
      "description": "Working directory. Defaults to the active Location; relative paths resolve from that Location.",
      "type": "string",
    },
  },
  "required": [
    "command",
  ],
  "type": "object",
}
`;

exports[`tool parameters JSON Schema (wire shape) edit 1`] = `
{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
    "newString": {
      "description": "Replacement text, which must differ from oldString",
      "type": "string",
    },
    "oldString": {
      "description": "Exact text to replace",
      "type": "string",
    },
    "path": {
      "description": "File path to edit. Relative paths resolve within the active Location. Absolute paths inside that Location are accepted; external absolute paths require external_directory approval.",
      "type": "string",
    },
    "replaceAll": {
      "description": "Replace all exact occurrences of oldString (default false)",
      "type": "boolean",
    },
  },
  "required": [
    "path",
    "oldString",
    "newString",
  ],
  "type": "object",
}
`;

exports[`tool parameters JSON Schema (wire shape) glob 1`] = `
{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
    "limit": {
      "description": "Maximum results to return",
      "exclusiveMinimum": 0,
      "maximum": 9007199254740991,
      "minimum": -9007199254740991,
      "type": "integer",
    },
    "path": {
      "description": "The directory to search in. If not specified, the current working directory will be used. IMPORTANT: Omit this field to use the default directory. DO NOT enter "undefined" or "null" - simply omit it for the default behavior. Must be a valid directory path if provided.",
      "type": "string",
    },
    "pattern": {
      "description": "The glob pattern to match files against",
      "type": "string",
    },
  },
  "required": [
    "pattern",
  ],
  "type": "object",
}
`;

